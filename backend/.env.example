# Copier ce fichier en .env puis remplir les valeurs. Ne jamais committer .env.

# --- LLM (Ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:3b
LLM_TEMPERATURE=0.3
MAX_CONVERSATION_HISTORY=5
MAX_TOKENS_OUTPUT=200

# --- API ---
DATABASE_PATH=clients.db
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000

# --- Email ---
# EMAIL_SERVICE : gmail | mailtrap
EMAIL_SERVICE=gmail
# EMAIL_MODE : production (envoie vraiment) | dev (affiche dans le terminal, n'envoie rien)
EMAIL_MODE=dev

# --- Gmail SMTP ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# true = SSL direct (mettre SMTP_PORT=465) ; false = STARTTLS sur 587
SMTP_USE_SSL=false
# Si STARTTLS échoue, retente automatiquement en SSL sur le port 465
SMTP_FALLBACK_SSL=true
# Délai maximum (secondes) pour la connexion et chaque commande SMTP
SMTP_TIMEOUT=30
SMTP_EMAIL=your-email@gmail.com
# Mot de passe d'application Gmail (16 caractères), pas le mot de passe du compte
SMTP_PASSWORD=your-app-password

# --- Mailtrap (si EMAIL_SERVICE=mailtrap) ---
MAILTRAP_API_TOKEN=your-mailtrap-token

# --- Liens et destinataires ---
SUPPORT_EMAIL=support@example.com
RENEWAL_URL=https://vala.ma/renew
RESET_URL=https://vala.ma/reset

# --- Données de démo (create_db.py) ---
DEMO_CLIENT_EMAIL=demo@example.com
